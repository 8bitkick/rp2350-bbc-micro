# Turns files into a C table for romfs.c: cmake -DOUT=x.c -DFILES="name=path|..." -P embed_files.cmake
string(REPLACE "|" ";" FILES "${FILES}")
set(C "/* Generated by embed_files.cmake: do not edit. */\n#include \"romfs.h\"\n\n")
set(TABLE "")
set(I 0)
foreach(ENTRY ${FILES})
    string(FIND "${ENTRY}" "=" EQ)
    string(SUBSTRING "${ENTRY}" 0 ${EQ} NAME)
    math(EXPR EQ "${EQ} + 1")
    string(SUBSTRING "${ENTRY}" ${EQ} -1 PATH)
    file(READ "${PATH}" HEX HEX)
    file(SIZE "${PATH}" SIZE)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" BYTES "${BYTES}")
    string(APPEND C "static const uint8_t s_file_${I}[${SIZE}] __attribute__((aligned(4))) = {\n${BYTES}\n};\n\n")
    string(APPEND TABLE "    {\"${NAME}\", s_file_${I}, ${SIZE}},\n")
    math(EXPR I "${I} + 1")
endforeach()
string(APPEND C "const struct romfs_file romfs_files[] = {\n${TABLE}};\nconst unsigned romfs_num_files = ${I};\n")
file(WRITE "${OUT}" "${C}")
