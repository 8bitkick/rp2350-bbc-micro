; WS2812 LEDs (the Presto's seven on the back): 24 bits a LED, GRB, most significant first, at
; 800 kHz with 10 PIO cycles a bit (as the pico-examples ws2812.pio): a 1 is high for 7 cycles,
; a 0 for 3. Autopull 24 bits; the data is each LED's colour << 8. Side-set is the data pin.

.program ws2812
.side_set 1

.define public T1 3
.define public T2 3
.define public T3 4

.wrap_target
bitloop:
    out x, 1        side 0 [T3 - 1]
    jmp !x do_zero  side 1 [T1 - 1]
do_one:
    jmp bitloop     side 1 [T2 - 1]
do_zero:
    nop             side 0 [T2 - 1]
.wrap
